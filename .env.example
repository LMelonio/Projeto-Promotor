# Copie este arquivo para ".env" e preencha com as credenciais do projeto Supabase.
# NUNCA commitar o .env real — apenas o .example fica no controle de versão.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui

# Usado apenas pelo script "npm run gen:types" (não embarca no app)
SUPABASE_PROJECT_ID=seu-project-id
